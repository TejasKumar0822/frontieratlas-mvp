# LLM providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional Product Hunt API token
PRODUCT_HUNT_TOKEN=

# Optional GitHub token for higher API limits
GITHUB_TOKEN=

# Runtime
REQUEST_TIMEOUT=30
CRAWL_CONCURRENCY=20
LLM_CONCURRENCY=5
MAX_RETRIES=4
DATABASE_URL=sqlite:///data/frontieratlas.db

# Limits for the trial
STARTUP_LIMIT=1000
PRODUCT_LIMIT=1000
PAPER_LIMIT=1000
FRESHNESS_HOURS=24

# Google Sheets is optional. Set credentials path and spreadsheet title if you want upload.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_TITLE=FrontierAtlas Demo Output
